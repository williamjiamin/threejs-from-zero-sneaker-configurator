{
  "name": "wardrobe-web-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/stage-game-assets.mjs && vite --host 127.0.0.1",
    "build": "node scripts/stage-game-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fixtures": "python scripts/generate_mock_glb.py --check",
    "test:native": "node --experimental-strip-types --test tests/native.test.mjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "6.0.0",
    "vitest": "2.1.8",
    "@types/node": "22.10.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
